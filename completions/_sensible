#compdef sensible

_sensible_hosts() {
  local dir=${sensible_config/#\~/$HOME}
  local -a files hosts
  files=($dir/hosts.d/*.yml(N))
  (( $#files )) || return 1
  hosts=(${(u)${(f)"$(sed -n 's/^\([A-Za-z0-9_.-]\{1,\}\):.*/\1/p' $files 2>/dev/null)"}})
  _wanted hosts expl host compadd -a hosts
}

_sensible_secrets() {
  local file=${${(Q)line[2]}/#\~/$HOME}
  local expl src=$file first
  local -a secrets
  # Showing a whole-file secret would decrypt it.
  [[ $src == /* ]] || src=${sensible_config/#\~/$HOME}/$src
  IFS= read -r first 2>/dev/null <$src
  [[ $first == '-----BEGIN AGE ENCRYPTED FILE-----'* ]] && return 1
  secrets=(${(f)"$($sensible_bin --config ${sensible_config/#\~/$HOME} secret show $file 2>/dev/null)"})
  (( $#secrets )) || return 1
  _wanted secrets expl secret compadd -a secrets
}

_sensible() {
  local curcontext=$curcontext state line ret=1
  local sensible_bin=${words[1]/#\~/$HOME}
  local -A opt_args

  _arguments -C \
    '--config=[configuration directory]:directory:_directories' \
    '--debug[show debugging output]' \
    '1:command:->command' \
    '*::arg:->args' && ret=0

  local -a commands=(
    'bootstrap:set up a host for sensible to manage'
    'bootstrap-binary:make a binary that sets up new machines'
    'apply:apply the configuration to hosts'
    'prune:remove what hosts have left over, such as old volumes'
    'facts:print facts gathered from hosts'
    'render:print what apply would make hosts have'
    'secret:encrypt or show secrets'
  )

  case $state in
    command)
      _describe -t commands command commands && ret=0
      ;;
    args)
      local sensible_config=${opt_args[--config]:-${SENSIBLE_CONFIG:-.}}
      curcontext=${curcontext%:*:*}:sensible-$words[1]:
      case $words[1] in
        bootstrap)
          _arguments \
            '--user=[account to set the host up through]:account:_users' \
            '--rotate[replace existing credentials]' \
            '--host-key=[expected SHA256 fingerprint of the host key]:fingerprint:' \
            '--bootstrap-key[connect with the bootstrap key]' \
            '1:host:_sensible_hosts' && ret=0
          ;;
        bootstrap-binary)
          _arguments \
            '-o[file to write the binary to]:file:_files' \
            '--arch=[architecture to build for]:arch:(amd64 arm64)' && ret=0
          ;;
        apply)
          _arguments \
            '--yes[apply without asking]' \
            '--update-packages[bring packages up to date first]' \
            '*:host:_sensible_hosts' && ret=0
          ;;
        facts|prune)
          _arguments '*:host:_sensible_hosts' && ret=0
          ;;
        render)
          _arguments \
            '--facts=[read facts from a file instead of connecting]:file:_files' \
            '--json[print JSON]' \
            '*:host:_sensible_hosts' && ret=0
          ;;
        secret)
          _arguments -C \
            '--raw[print an armored age file and keep piped input exactly]' \
            '1:action:((encrypt\:"encrypt a secret from stdin" show\:"list or decrypt secrets in a file"))' \
            '2: :->file' \
            '3: :->secret' \
            '*: :' && ret=0
          if [[ $line[1] == show ]]; then
            case $state in
              file) _files -W ${${sensible_config/#\~/$HOME}:a} && ret=0 ;;
              secret) _sensible_secrets && ret=0 ;;
            esac
          fi
          ;;
      esac
      ;;
  esac

  return ret
}

_sensible "$@"
